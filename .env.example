# ---------------------------------------------------------------------------
# TradingBrain environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated API keys accepted for authenticated endpoints (dev only).
API_AUTH_TOKENS=

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_brain
POSTGRES_USER=trading_brain
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://trading_brain:change-me@localhost:5432/trading_brain

# --- Redis (worker / caching / task queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Obsidian integration (Local REST API / MCP) ---
OBSIDIAN_BASE_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=
OBSIDIAN_VAULT_PATH=

# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Market data providers ---
# Provider selection: "mock" requires no API key and is the default for local dev.
MARKET_DATA_PROVIDER=mock
