# ---------------------------------------------------------------------------
# TradingBrain environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated API keys accepted for authenticated endpoints (dev only).
API_AUTH_TOKENS=

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_brain
POSTGRES_USER=trading_brain
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://trading_brain:change-me@localhost:5432/trading_brain

# --- Redis (worker / caching / task queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Obsidian integration (Local REST API / MCP) ---
OBSIDIAN_BASE_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=
OBSIDIAN_VAULT_PATH=
# The plugin serves a self-signed cert on loopback, so verification is off
# by default. Better: download its name-constrained CA from
# https://127.0.0.1:27124/obsidian-local-rest-api.crt and point at it here
# (this takes precedence over OBSIDIAN_VERIFY_TLS).
OBSIDIAN_CA_CERT_PATH=
OBSIDIAN_VERIFY_TLS=false

# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Market data providers ---
# Primary provider: mock | yahoo | alphavantage.
# "mock" requires no API key and is the default for local dev.
MARKET_DATA_PROVIDER=mock
# Comma-separated providers tried, in order, when the primary fails.
# "mock" is rejected here on purpose: generated data must never silently
# stand in for real market data (Rule 4).
MARKET_DATA_FALLBACKS=
MARKET_DATA_TIMEOUT_SECONDS=10
# Only needed if alphavantage is used as primary or fallback.
ALPHAVANTAGE_API_KEY=
